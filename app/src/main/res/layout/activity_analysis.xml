<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Chart image -->
        <ImageView
            android:id="@+id/imgChart"
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:background="@drawable/bg_image_placeholder"
            android:contentDescription="@string/chart_image"
            android:padding="2dp"
            android:scaleType="fitCenter" />

        <!-- Analyse button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAnalyze"
            style="@style/PrimaryButton"
            android:layout_marginTop="16dp"
            android:text="@string/analyze_chart" />

        <!-- Loading state -->
        <LinearLayout
            android:id="@+id/loadingBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:indeterminate="true"
                app:indicatorColor="@color/primary"
                app:trackThickness="4dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/analyzing"
                android:textColor="@color/text_secondary"
                android:textSize="15sp" />
        </LinearLayout>

        <!-- Error state -->
        <LinearLayout
            android:id="@+id/errorBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/txtError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/bear"
                android:textSize="15sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRetry"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/retry"
                android:textColor="@color/primary" />
        </LinearLayout>

        <!-- Results -->
        <LinearLayout
            android:id="@+id/resultContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- Direction -->
            <com.google.android.material.card.MaterialCardView style="@style/CardSection">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView style="@style/SectionTitle" android:text="@string/section_direction" />

                    <TextView
                        android:id="@+id/txtDirection"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_badge"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="6dp"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Trend -->
            <com.google.android.material.card.MaterialCardView
                style="@style/CardSection"
                android:layout_marginTop="12dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <TextView style="@style/SectionTitle" android:text="@string/section_trend" />
                    <TextView android:id="@+id/txtTrend" style="@style/SectionBody" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Risk -->
            <com.google.android.material.card.MaterialCardView
                style="@style/CardSection"
                android:layout_marginTop="12dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <TextView style="@style/SectionTitle" android:text="@string/section_risk" />
                    <TextView
                        android:id="@+id/txtRisk"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_badge"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="6dp"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Full analysis -->
            <com.google.android.material.card.MaterialCardView
                style="@style/CardSection"
                android:layout_marginTop="12dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <TextView style="@style/SectionTitle" android:text="@string/section_analysis" />
                    <TextView android:id="@+id/txtAnalysis" style="@style/SectionBody" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Zones -->
            <com.google.android.material.card.MaterialCardView
                style="@style/CardSection"
                android:layout_marginTop="12dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <TextView style="@style/SectionTitle" android:text="@string/section_zones" />
                    <TextView android:id="@+id/txtZones" style="@style/SectionBody" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Scenario -->
            <com.google.android.material.card.MaterialCardView
                style="@style/CardSection"
                android:layout_marginTop="12dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <TextView style="@style/SectionTitle" android:text="@string/section_scenario" />
                    <TextView android:id="@+id/txtScenario" style="@style/SectionBody" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Advice -->
            <com.google.android.material.card.MaterialCardView
                style="@style/CardSection"
                android:layout_marginTop="12dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <TextView style="@style/SectionTitle" android:text="@string/section_advice" />
                    <TextView android:id="@+id/txtAdvice" style="@style/SectionBody" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Disclaimer -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/disclaimer"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>

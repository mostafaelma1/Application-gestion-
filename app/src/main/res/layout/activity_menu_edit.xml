<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <include
        android:id="@+id/header"
        layout="@layout/include_header" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Paramètres du menu -->
            <com.google.android.material.card.MaterialCardView style="@style/CardSection">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <EditText
                        android:id="@+id/editName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/hint_menu_name"
                        android:importantForAutofill="no"
                        android:inputType="textCapSentences" />

                    <EditText
                        android:id="@+id/editCouverts"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:hint="@string/hint_couverts"
                        android:importantForAutofill="no"
                        android:inputType="number" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">

                        <EditText
                            android:id="@+id/editFees"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="6dp"
                            android:layout_weight="1"
                            android:hint="@string/hint_fees"
                            android:importantForAutofill="no"
                            android:inputType="numberDecimal" />

                        <EditText
                            android:id="@+id/editMargin"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:layout_weight="1"
                            android:hint="@string/hint_margin"
                            android:importantForAutofill="no"
                            android:inputType="numberDecimal" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSaveMenu"
                        style="@style/PrimaryButton"
                        android:layout_marginTop="14dp"
                        android:text="@string/save" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Plats du menu -->
            <com.google.android.material.card.MaterialCardView
                style="@style/CardSection"
                android:layout_marginTop="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        style="@style/SectionTitle"
                        android:text="@string/menu_dishes_label" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/recyclerDishes"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:nestedScrollingEnabled="false" />

                    <TextView
                        android:id="@+id/dishesEmpty"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/menu_dishes_empty"
                        android:textColor="@color/text_secondary"
                        android:textSize="14sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnAddDish"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="@string/add_dish_to_menu"
                        android:textColor="@color/primary"
                        app:strokeColor="@color/stroke" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Résultat -->
            <com.google.android.material.card.MaterialCardView
                style="@style/CardSection"
                android:layout_marginTop="14dp">

                <LinearLayout
                    android:id="@+id/resultBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        style="@style/SectionTitle"
                        android:text="@string/res_title" />

                    <LinearLayout style="@style/ResultRow">
                        <TextView style="@style/ResultLabel" android:text="@string/res_material_pp" />
                        <TextView android:id="@+id/resMaterialPp" style="@style/ResultValue" />
                    </LinearLayout>

                    <LinearLayout style="@style/ResultRow">
                        <TextView style="@style/ResultLabel" android:text="@string/res_fees_pp" />
                        <TextView android:id="@+id/resFeesPp" style="@style/ResultValue" />
                    </LinearLayout>

                    <LinearLayout style="@style/ResultRow">
                        <TextView style="@style/ResultLabel" android:text="@string/res_costprice_pp" />
                        <TextView android:id="@+id/resCostPricePp" style="@style/ResultValue" />
                    </LinearLayout>

                    <LinearLayout style="@style/ResultRow">
                        <TextView style="@style/ResultLabel" android:text="@string/res_margin_pp" />
                        <TextView android:id="@+id/resMarginPp" style="@style/ResultValue" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginVertical="10dp"
                        android:background="@color/stroke" />

                    <LinearLayout style="@style/ResultRow">
                        <TextView style="@style/ResultLabel"
                            android:text="@string/res_selling_pp"
                            android:textColor="@color/text_primary"
                            android:textStyle="bold" />
                        <TextView android:id="@+id/resSellingPp"
                            style="@style/ResultValue"
                            android:textColor="@color/primary"
                            android:textSize="18sp" />
                    </LinearLayout>

                    <LinearLayout style="@style/ResultRow">
                        <TextView style="@style/ResultLabel" android:text="@string/res_foodcost" />
                        <TextView android:id="@+id/resFoodCost" style="@style/ResultValue" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginVertical="10dp"
                        android:background="@color/stroke" />

                    <LinearLayout style="@style/ResultRow">
                        <TextView style="@style/ResultLabel" android:text="@string/res_material_total" />
                        <TextView android:id="@+id/resMaterialTotal" style="@style/ResultValue" />
                    </LinearLayout>

                    <LinearLayout style="@style/ResultRow">
                        <TextView style="@style/ResultLabel" android:text="@string/res_selling_total" />
                        <TextView android:id="@+id/resSellingTotal" style="@style/ResultValue" />
                    </LinearLayout>

                    <LinearLayout style="@style/ResultRow">
                        <TextView style="@style/ResultLabel"
                            android:text="@string/res_margin_total"
                            android:textStyle="bold" />
                        <TextView android:id="@+id/resMarginTotal"
                            style="@style/ResultValue"
                            android:textColor="@color/accent"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </ScrollView>
</LinearLayout>

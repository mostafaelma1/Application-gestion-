# Copy this file to "local.properties" and fill in your values.
# local.properties is git-ignored and never committed.

# Path to your Android SDK (Android Studio fills this automatically).
# sdk.dir=/Users/you/Library/Android/sdk

# Optional: bake a default Anthropic API key into the build so you don't have to
# type it on first launch. You can also leave this empty and enter the key in the
# app's Settings screen instead.
ANTHROPIC_API_KEY=
